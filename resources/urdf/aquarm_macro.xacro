    <joint name="${prefix}_gripper_joint12" type="revolute">
      <origin xyz="-0.020243 0.0 0.045719" rpy="0 0 0" />
      <parent link="${prefix}_gripper_link8_1" />
      <child link="${prefix}_gripper_link9_1" />
      <axis xyz="0 -1 0" />
      <limit lower="0.0" upper="1.0" effort="10" velocity="100" />
      <mimic joint="${prefix}_gripper_joint1" multiplier="1" offset="0" />
    </joint>

    <link name="${prefix}_tool" />

    <joint name="${prefix}_tool_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.204695" />
      <parent link="${prefix}_gripper_base_link" />
      <child link="${prefix}_tool" />
    </joint>

  </xacro:macro>

</robot>
