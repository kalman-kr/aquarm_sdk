<?xml version="1.0"?>
<robot name="aquarm_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="aquarm" params="prefix parent mesh_path *origin">
    <joint name="${prefix}_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
